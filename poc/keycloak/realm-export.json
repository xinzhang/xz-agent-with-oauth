{
  "realm": "poc-realm",
  "enabled": true,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "poc-agent-client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "poc-secret",
      "redirectUris": ["http://localhost:8090/*"],
      "webOrigins": ["*"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "users": [
    {
      "username": "testuser",
      "email": "test@example.com",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "testpass",
          "temporary": false
        }
      ]
    }
  ]
}
